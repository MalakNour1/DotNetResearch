    <UserSecretsId>ef36a856-54dd-4b36-8a2d-ece16622962a</UserSecretsId>
    <RootNamespace>FastEndpointsVersion</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="8.3.0" />
